# Arquivo .env exclusivo do servidor. Nunca envie para o GitHub ou para o navegador.
PORT=3000
HOST=127.0.0.1
ADMIN_API_KEY=troque-por-uma-chave-aleatoria-com-mais-de-20-caracteres
META_APP_SECRET=segredo-do-app-meta-de-teste
META_VERIFY_TOKEN=token-privado-do-webhook-meta
# URL do projeto Postgres/Supabase. Se não definida, usa memória somente para TESTES.
DATABASE_URL=
# Opcional. Sem chave a IA usa regras locais em pt-BR.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Para testar mensagens localmente via /api/demo/inbound
ENABLE_DEMO=false
# Cria rascunho em segundo plano APENAS em desenvolvimento; nao envia WhatsApp.
AUTO_DRAFTS=false
# NODE_ENV=production exige banco e segredos fortes e ambiente seguro.
NODE_ENV=development

# Login do operador: hash gerado por passwordHash de src/auth.js. Nunca publicar a senha.
OPERATOR_USERNAME=pedro
OPERATOR_PASSWORD_SCRYPT=
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Só marcar true após configurar app Meta real; não significa teste aprovado.
META_CONFIGURED=false
